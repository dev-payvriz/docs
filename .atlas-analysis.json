  "keyFeatures": [
    "PAN verification and detailed lookup (individual and business)",
    "Aadhaar OKYC (OTP-based identity verification) and QR decode",
    "Driving licence, passport, and voter ID verification",
    "Document OCR for Aadhaar, PAN, driving licence, and invoices",
    "Business verification: CIN/MCA, GST, Udyam (MSME), shop & establishment",
    "Bank account verification (penny-drop and pennyless) with IFSC lookup",
    "Bank statement PDF analysis (multi-step upload and reporting workflow)",
    "Face match and liveness detection",
    "DigiLocker integration for government-issued document fetching",
    "Cross-reference lookups: Aadhaar-to-PAN, Mobile-to-PAN, PAN-to-UAN, and more",
    "Vehicle RC verification, e-challan lookup, and FASTag toll history",
    "Mobile network intelligence and reachability",
    "UPI VPA verification and Experian credit report",
    "Employment history and court record checks via UAN",
    "Electronic signature (eSign) workflow with Aadhaar authentication",
    "Idempotency-Key support on v2 endpoints for safe retries",
    "Async verification polling for long-running checks"
  ],
